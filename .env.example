ADMIN_PASSWORD=your-secure-password
SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000

# Cloudinary (signed uploads via local server.py — optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=fazil-portfolio

# Browser uploads: set unsigned preset in public/js/firebase-config.js
# Firebase web config: public/js/firebase-config.js
# Firestore rules: firebase/firestore.rules
# Set .firebaserc "default" before deploy
